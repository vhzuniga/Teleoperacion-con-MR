<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gripper_control</name>
  <version>0.0.0</version>
  <description>Control del gripper Lite6 vía WebSocket + simulación.</description>

  <maintainer email="hugo@todo.todo">hugo</maintainer>
  <license>Apache-2.0</license>

  <!-- Dependencias REALES necesarias -->
  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>xarm_controller</exec_depend>

  <!-- La librería websocket-client se instala con pip, no va como rosdep -->
  <exec_depend>python3-websocket</exec_depend>

  <!-- Dependencias de test (opcionales) -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
